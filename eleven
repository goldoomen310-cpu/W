            end
            refreshDraculaWorkers()
            Library:Notify({
                Title = "Dracula",
                Description = v and "Hit Dracula Enabled" or "Hit Dracula Disabled",
                Time = 2,
                Icon = v and "flame" or "x",
            })
            pcall(updateDraculaESP)
        end
    })

