local KillAuraTab = Window:AddTab("Kill Aura", "sword")

-- === Kill Aura + Hitbox Expander (Position-match Barrel Mapping) ===
-- Uses position matching to exclude camera barrel zombies from real zombie targeting

-- PERFORMANCE FIX: Flag to suppress notifications during UI initialization
local KillAuraTab_InitComplete = false

-- Config
local DEBUG = false

-- Anti-Detection Settings (Balanced: fast but safe)
local KILLAURA_ANTICHEAT_BYPASS = false -- Enable anti-detection measures
local KILLAURA_MIN_DELAY = 0.1
local KILLAURA_RANDOMIZE_DELAY = false -- Add random variation to timing
local KILLAURA_MAX_ATTACKS_PER_SECOND = 8
local KILLAURA_SWING_TO_HIT_DELAY = 0.06 -- Delay between Swing and HitZombieM (human swing gap)
local KILLAURA_PER_ZOMBIE_COOLDOWN = 0.1

-- ==== SMART KILL DETECTION (Skin HUB style kill-verification) ====
-- Walks like Skin HUB's Smart Aura: watches leaderstats.Kills. If a zombie in
-- the inner "danger zone" survives longer than the kill timeout without the
-- kill counter increasing, the fast multi-target burst is auto-suspended and
-- swapped for a slow single-target probe. Normal aura only resumes once a hit
-- actually registers a kill. This stops remote spam on unreachable/rejected
-- targets, which is what really gets flagged.
local KILLAURA_SMART_INNER_RADIUS = 13 -- Inner danger-zone radius (studs)
local KILLAURA_SMART_KILL_TIMEOUT = 2.0 -- Seconds before suspicion if no kill
local KILLAURA_SMART_CHECK_INTERVAL = 0.5 -- update-loop cadence
local KILLAURA_SMART_RETRY_INTERVAL = 2.0 -- Single-attack probe cadence
local KillAura_smart = {
    enabled = true,
    workable = false, -- true only when leaderstats.Kills exists
    auraClosed = false,
    probeMode = false,
    innerEntryKills = {},
    retryTimer = 0,
    innerRadius = KILLAURA_SMART_INNER_RADIUS,
}
local KillAura_smartThread = nil

-- State variables (Global for keybind access)
KillAuraEnabled = false
KillAuraRange = 10
KillAuraAttackSpeed = 0.1 -- Default attack speed (seconds)
KillAuraRandomness = 0 -- Random variation (0-1, percentage of attack speed)
KillAuraMode = "Fast" -- "Legit" (human-like) or "Fast" (0.5s interval)
KillAuraPreset = "Balanced" -- Combat preset: "Safe", "Balanced", "Aggressive", "Max"
KillAura_SafeMode = false -- Strict smart-aura mode: single verified probe attacks only (no multi-target burst)
KillAura_MaxRange = 30 -- Max range restored to 30 studs
KillAuraMultiTargets = 5
KillAuraAutoLook = false
KillAura_AutoEquipMelee = false
IgnoreSpawningZombies = true
KillAura_HitboxExpanderEnabled = false

-- Zombie type targeting (which types to kill) - global for config
-- Types: Shambler (Normal), Bomber (Barrel), Runner (Fast), Zapper (Sapper), Igniter, Cuirassier (Slim)
KillAura_SelectedZombieTypes = {
    ["Shambler"] = true,
    ["Bomber"] = false,
    ["Runner"] = true,
    ["Zapper"] = true,
    ["Igniter"] = true,
    ["Cuirassier"] = true
}

-- Zombie priority for Kill Aura: lower number = higher priority (attacked first)
-- 0 = not prioritised (attacked by distance), 1 = highest priority, etc.
KillAura_ZombiePriority = {
