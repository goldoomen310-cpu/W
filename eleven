            else
                stopSilverEspLoop()
                clearSilverESP()
            end
            Library:Notify({
                Title = "Silver ESP",
                Description = v and "Enabled" or "Disabled",
                Time = 2,
                Icon = v and "eye" or "x",
            })
        end
    })
