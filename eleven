    -- ─────────────────────────────────────────────
    -- Anti Tackle  (from source: anti grab.txt / Runner Escape)
    -- When a Runner starts its attack (Pin == "RunnerAttack"),
    -- tween the character skyward, wait for the pin to clear,
    -- then snap back instantly.
    -- ─────────────────────────────────────────────
    local _antiTackleEnabled = false
    local _antiTackleTackled = false
    local _antiTackleThread  = nil
    local SKY_HEIGHT         = 3000
    local TWEEN_SPEED        = 0.08
    local CHECK_DELAY        = 0.05

    local function getCharacter()
        return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    end

    local function getRoot(character)
        return character and character:FindFirstChild("HumanoidRootPart")
    end

    local function getPin()
        local character = getCharacter()
        local states = character:FindFirstChild("UserStates")
        if not states then return nil end
        return states:FindFirstChild("Pin")
    end

    local function _antiTackle_loop()
        while task.wait(CHECK_DELAY) do
            if not _antiTackleEnabled then break end

            local character = getCharacter()
            local root = getRoot(character)
            local pin = getPin()
            if not pin or not root then continue end

            if pin.Value == "RunnerAttack" and not _antiTackleTackled then
                _antiTackleTackled = true

                local oldCFrame = root.CFrame
                local skyCFrame = oldCFrame + Vector3.new(0, SKY_HEIGHT, 0)

                local tweenUp = TweenService:Create(
                    root,
                    TweenInfo.new(TWEEN_SPEED, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
                    { CFrame = skyCFrame }
                )
                tweenUp:Play()

                repeat
                    task.wait()
                until pin.Value ~= "RunnerAttack"

                if root and root.Parent then
                    root.CFrame = oldCFrame
                end

                _antiTackleTackled = false
            end
        end
        _antiTackleThread = nil
    end

    local function _antiTackle_start()
        if _antiTackleThread then return end
        _antiTackleTackled = false
        _antiTackleThread = task.spawn(_antiTackle_loop)
    end

    local function _antiTackle_stop()
        _antiTackleEnabled = false
        _antiTackleTackled = false
        if _antiTackleThread then
            pcall(function() task.cancel(_antiTackleThread) end)
            _antiTackleThread = nil
        end
    end

    LP_ZombieSection:AddToggle('AntiTackle', {
        Text    = "Anti Tackle (Runner)",
        Default = false,
        Tooltip = "Remove runners tackling you.",
        Callback = function(state)
            _antiTackleEnabled = state
            if state then
                _antiTackle_start()
                Library:Notify({
