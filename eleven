        Callback = function(state)
            _antiGrabEnabled = state
            if state then
                _antiGrab_start()
                Library:Notify({
                    Title   = "Anti Grab",
                    Description = "Anti Grab enabled -- zombies can't hold you.",
                    Time = 3,
                    Icon    = "shield-check",
                })
            else
                _antiGrab_stop()
