        -- ===== BYPASS SLOWDOWN =====
        -- Watches the humanoid's WalkSpeed via GetPropertyChangedSignal.
        -- If the game (Lance, Cuirassier armour, heavy weapons) sets WalkSpeed below the
        -- threshold the script immediately snaps it back to desiredWalkSpeed.
        -- Does NOT fight the existing "Apply WalkSpeed" toggle â€“ both can coexist.

        _G.KatchiBypassSlowState = _G.KatchiBypassSlowState or {
            enabled = false,
            conn = nil,
            charConn = nil
        }

        _G.KatchiAttachBypassSlow = function(character)
            local stateRef = _G.KatchiBypassSlowState
            if stateRef.conn then pcall(function() stateRef.conn:Disconnect() end) end
            stateRef.conn = nil
            if not stateRef.enabled then return end
            local hum = character and character:FindFirstChildOfClass("Humanoid")
            if not hum then return end
            stateRef.conn = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
                if not stateRef.enabled then return end
                if hum.WalkSpeed < 16 then
                    pcall(function() hum.WalkSpeed = 16 end)
                end
            end)
        end

        _G.KatchiStartBypassSlow = function()
            local char = LocalPlayer.Character
            if char then _G.KatchiAttachBypassSlow(char) end
            if _G.KatchiBypassSlowState.charConn then pcall(function() _G.KatchiBypassSlowState.charConn:Disconnect() end) end
            _G.KatchiBypassSlowState.charConn = LocalPlayer.CharacterAdded:Connect(function(newChar)
                task.wait(0.5)
                _G.KatchiAttachBypassSlow(newChar)
            end)
        end

        _G.KatchiStopBypassSlow = function()
            if _G.KatchiBypassSlowState.conn then
                pcall(function() _G.KatchiBypassSlowState.conn:Disconnect() end)
                _G.KatchiBypassSlowState.conn = nil
            end
            if _G.KatchiBypassSlowState.charConn then
                pcall(function() _G.KatchiBypassSlowState.charConn:Disconnect() end)
                _G.KatchiBypassSlowState.charConn = nil
            end
        end

        ServerModifiersSection:AddToggle('ServerMods_BypassSlow', {
