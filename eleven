local function RemoveVisual(espType, zombie)
    local data = ESPData[espType][zombie]
    if not data then return end
    if data.highlight then pcall(function() data.highlight:Destroy() end) end
    if data.billboard then pcall(function() data.billboard:Destroy() end) end
    if data.dot then pcall(function() data.dot:Destroy() end) end
    data.highlight = nil
    data.billboard = nil
    data.dot = nil
    data.frame = nil
    data.label = nil
    data.distLabel = nil
    ESPData[espType][zombie] = nil
    if zombie then
        ESPPendingRemoval[zombie] = nil
        IdentifiedIgniters[zombie] = nil
    end
end

local _zombiesBuf = {}
local _zombiesBufLen = 0
local _zombieSetBuf = {}

local function CollectZombies()
    _zombiesBufLen = 0
    local cache = _G.CentralZombieCache
    local count = _G.CentralZombieCount
    for i = 1, count do
        local z = cache[i]
        local hasCharacter = z:FindFirstChild("Character")
        local nameStartsWithUnderscore = z.Name:sub(1, 1) == "_"
        if not hasCharacter and not nameStartsWithUnderscore then
            _zombiesBufLen = _zombiesBufLen + 1
            _zombiesBuf[_zombiesBufLen] = z
        end
    end
    for i = _zombiesBufLen + 1, #_zombiesBuf do _zombiesBuf[i] = nil end
    return _zombiesBuf, _zombiesBufLen
end

local function ScanAll()
    local zombies, zombieCount = CollectZombies()

    if _G.ZombieLimiterEnabled then
        local lp = game:GetService("Players").LocalPlayer
        local myHrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        if myHrp then
            local myPos = myHrp.Position
            local shouldHide = _G.ZombieLimiterHideModels

            local visibleSet = {}

            if _G.ZombieLimiterMode == "Radius" then
                local radius = _G.ZombieLimiterRadius or 100
                for i = 1, zombieCount do
                    local z = zombies[i]
                    local zPart = z.PrimaryPart or z:FindFirstChild("HumanoidRootPart") or z:FindFirstChild("Head")
                    if zPart and (myPos - zPart.Position).Magnitude <= radius then
                        visibleSet[z] = true
                    end
                end
            elseif _G.ZombieLimiterMode == "Max Zombies" then
                local maxZombies = _G.ZombieLimiterMaxZombies or 50
                local sortBuf = _G._ZL_SortBuf or {}
                _G._ZL_SortBuf = sortBuf
                local sortCount = 0
                for i = 1, zombieCount do
                    local z = zombies[i]
                    local zPart = z.PrimaryPart or z:FindFirstChild("HumanoidRootPart") or z:FindFirstChild("Head")
                    if zPart then
                        sortCount = sortCount + 1
                        sortBuf[sortCount] = { z = z, d = (myPos - zPart.Position).Magnitude }
                    end
                end
                if sortCount > 1 then
                    table.sort(sortBuf, function(a, b) return a.d < b.d end)
                end
                for i = 1, math.min(sortCount, maxZombies) do
                    visibleSet[sortBuf[i].z] = true
                end
                for i = sortCount + 1, #sortBuf do sortBuf[i] = nil end
            end

            local function iterZombieParts(z)
                local result = {}
                local function recurse(parent, depth)
                    if depth > 4 then return end
                    for _, child in parent:GetChildren() do
                        local cls = child.ClassName
                        if cls == "BasePart" or cls == "MeshPart"
                        or cls == "UnionOperation" or cls == "SpecialMesh"
                        or cls == "Texture" or cls == "Decal"
                        or cls == "SelectionBox" or cls == "SurfaceAppearance"
                        or cls == "BillboardGui" or cls == "SurfaceGui" then
                            result[#result + 1] = child
                        elseif child:IsA("Model") or child:IsA("Folder")
                            or child:IsA("Accessory") or child:IsA("Tool") then
                            recurse(child, depth + 1)
                        end
                    end
                end
                recurse(z, 0)
                return result
            end

            local function saveAndHideZombie(z)
                local saved = {}
                for _, part in iterZombieParts(z) do
                    local cls = part.ClassName
                    if cls == "BasePart" or cls == "MeshPart" or cls == "UnionOperation" then
                        saved[part] = { ltm = part.LocalTransparencyModifier, tr = part.Transparency }
                        part.LocalTransparencyModifier = 1
                    elseif cls == "Decal" or cls == "Texture" or cls == "SurfaceAppearance" then
                        saved[part] = { tr = part.Transparency }
                        part.Transparency = 1
                    elseif cls == "BillboardGui" or cls == "SurfaceGui" then
                        saved[part] = { en = part.Enabled }
                        part.Enabled = false
                    elseif cls == "SelectionBox" then
                        saved[part] = { vis = part.Visible }
                        pcall(function() part.Visible = false end)
                    end
                end
                _limiterHiddenSet[z] = saved
            end

            local function restoreZombie(z)
                local saved = _limiterHiddenSet[z]
                if not saved then return end
                for part, orig in saved do
                    if part and part.Parent then
                        pcall(function()
                            local cls = part.ClassName
                            if cls == "BasePart" or cls == "MeshPart" or cls == "UnionOperation" then
                                part.LocalTransparencyModifier = orig.ltm or 0
                            elseif cls == "Decal" or cls == "Texture" or cls == "SurfaceAppearance" then
                                part.Transparency = orig.tr or 0
                            elseif cls == "BillboardGui" or cls == "SurfaceGui" then
                                part.Enabled = orig.en ~= false
                            elseif cls == "SelectionBox" then
                                part.Visible = orig.vis ~= false
                            end
                        end)
                    end
                end
                _limiterHiddenSet[z] = nil
            end

            if shouldHide then
                for z in visibleSet do
                    if _limiterHiddenSet[z] then
                        restoreZombie(z)
                    end
                end
                for i = 1, zombieCount do
                    local z = zombies[i]
                    if not visibleSet[z] and not _limiterHiddenSet[z] then
                        saveAndHideZombie(z)
                    end
                end
                for z in _limiterHiddenSet do
                    if not z or not z.Parent then
                        _limiterHiddenSet[z] = nil
                    end
                end
            else
        if tableHasEntries(_limiterHiddenSet) then
                    for z in _limiterHiddenSet do
                        if z and z.Parent then restoreZombie(z) end
                    end
                    table.clear(_limiterHiddenSet)
                end
            end

            local filteredBuf = _G._ZL_FilteredBuf or {}
            _G._ZL_FilteredBuf = filteredBuf
            local filteredCount = 0
            for i = 1, zombieCount do
                if visibleSet[zombies[i]] then
                    filteredCount = filteredCount + 1
                    filteredBuf[filteredCount] = zombies[i]
                end
            end
            for i = filteredCount + 1, #filteredBuf do filteredBuf[i] = nil end
            zombies = filteredBuf
            zombieCount = filteredCount
        end
    else
            if tableHasEntries(_limiterHiddenSet) then
            for z in _limiterHiddenSet do
                if z and z.Parent then
                    local saved = _limiterHiddenSet[z]
                    if saved then
                        for part, orig in saved do
                            if part and part.Parent then
                                pcall(function()
                                    local cls = part.ClassName
                                    if cls == "BasePart" or cls == "MeshPart" or cls == "UnionOperation" then
                                        part.LocalTransparencyModifier = orig.ltm or 0
                                    elseif cls == "Decal" or cls == "Texture" or cls == "SurfaceAppearance" then
                                        part.Transparency = orig.tr or 0
                                    elseif cls == "BillboardGui" or cls == "SurfaceGui" then
                                        part.Enabled = orig.en ~= false
                                    elseif cls == "SelectionBox" then
                                        part.Visible = orig.vis ~= false
                                    end
                                end)
                            end
                        end
                    end
                end
            end
            table.clear(_limiterHiddenSet)
        end
    end

    table.clear(_zombieSetBuf)
    for i = 1, zombieCount do
        _zombieSetBuf[zombies[i]] = true
    end

    local cam = workspace.CurrentCamera
    local camPos = cam and cam.CFrame.Position or Vector3.new(0, 0, 0)

    local globalCreated = 0

    for espType, enabled in EnabledESPs do
        if enabled then
            for z in ESPData[espType] do
                if not _zombieSetBuf[z] then
                    RemoveVisual(espType, z)
                end
            end

            for i = 1, zombieCount do
                if globalCreated >= ESP_SCAN_BATCH_SIZE then break end
                local z = zombies[i]

                if z:IsA("Model") and not ESPData[espType][z] then
                    local zombiePart = z.PrimaryPart or z:FindFirstChild("HumanoidRootPart") or z:FindFirstChild("Head")
                    if zombiePart then
                        local dist = (camPos - zombiePart.Position).Magnitude
                        if dist > ESP_CREATION_MAX_DISTANCE then continue end
                    end

                    local hasOtherESP = false
                    for otherType, otherData in ESPData do
                        if otherType ~= espType and otherData[z] then
                            hasOtherESP = true
                            break
                        end
                    end

                    if not hasOtherESP and ESPConfigs[espType].match(z) then
                        CreateVisual(espType, z)
                        globalCreated = globalCreated + 1
                    end
                end
            end
        else
            if tableHasEntries(ESPData[espType]) then
                for z in ESPData[espType] do
                    RemoveVisual(espType, z)
                end
                ESPData[espType] = setmetatable({}, { __mode = "k" })
            end
        end
    end
end

local function UpdateAllTransparencies()
    for espType, dataTable in ESPData do
        for _, data in dataTable do
            if data.highlight then data.highlight.FillTransparency = ChamsTransparency end
        end
    end
end

local function UpdateAllBillboards()
    local Camera = workspace.CurrentCamera
    if not Camera then return end

    local now = time()
    local cameraPos = Camera.CFrame.Position

    local anyEnabled = false
    for _, v in EnabledESPs do
        if v then anyEnabled = true; break end
    end
    if not anyEnabled then return end

    for espType, dataTable in ESPData do
        if not EnabledESPs[espType] then continue end
        if not tableHasEntries(dataTable) then continue end

        for zombie, data in dataTable do
            if not zombie or not zombie.Parent then
                if not ESPPendingRemoval[zombie] then
                    ESPPendingRemoval[zombie] = now
                elseif (now - ESPPendingRemoval[zombie]) >= ESP_REMOVAL_GRACE_PERIOD then
                    RemoveVisual(espType, zombie)
                    ESPPendingRemoval[zombie] = nil
                end
                if data.highlight then data.highlight.Enabled = false end
                if data.dot then data.dot.Enabled = false end
                if data.billboard then data.billboard.Enabled = false end
                continue
            end

            if ESPPendingRemoval[zombie] then
                ESPPendingRemoval[zombie] = nil
            end

            local adornee = (data.billboard and data.billboard.Adornee) or (data.dot and data.dot.Adornee)

            if not adornee or not adornee.Parent then
                local newPart = GetAdorneePart(zombie)
                if newPart then
                    if data.billboard then data.billboard.Adornee = newPart end
                    if data.dot then data.dot.Adornee = newPart end
                    adornee = newPart
                else
                    RemoveVisual(espType, zombie)
                    continue
                end
            end

            local pos = adornee.Position
            local dist = (cameraPos - pos).Magnitude
            local maxDist = data.maxDistance or ChamsMaxDistance

            if dist > maxDist then
                if data.highlight then data.highlight.Enabled = false end
                if data.dot then data.dot.Enabled = false end
                if data.billboard then data.billboard.Enabled = false end
                continue
            end

            local highlightAllowed = not PerformanceMode
            local dotAllowed = PerformanceMode

            if data.highlight then
                local hlWant = highlightAllowed and (dist <= maxDist)
                if data.highlight.Enabled ~= hlWant then data.highlight.Enabled = hlWant end
            end
            if data.dot then
                local dotWant = dotAllowed and (dist <= maxDist)
                if data.dot.Enabled ~= dotWant then data.dot.Enabled = dotWant end
            end

            if data.billboard then
                local wantEnabled = ShowBillboards and (dist < (PerformanceMode and 500 or 300))
                if data.billboard.Enabled ~= wantEnabled then
                    data.billboard.Enabled = wantEnabled
                end
                if wantEnabled and data.distLabel then
                    local flooredDist = math.floor(dist)
                    if data._lastDist ~= flooredDist then
                        data._lastDist = flooredDist
                        data.distLabel.Text = flooredDist .. " studs"
                    end
                end
            end
        end
    end
end

local function StartShared()
    activeCount = activeCount + 1
    if activeCount == 1 then
        ScanAll()
        scanLoop = task.spawn(function()
            local cleanupCounter = 0
            while activeCount > 0 do
                ScanAll()

                cleanupCounter = cleanupCounter + 1
                if cleanupCounter >= 10 then
                    cleanupCounter = 0
                    local now = time()
                    for zombie, timestamp in ESPPendingRemoval do
                        if not zombie or not zombie.Parent then
                            if (now - timestamp) > 5 then
                                ESPPendingRemoval[zombie] = nil
                            end
                        else
                            ESPPendingRemoval[zombie] = nil
                        end
                    end
                    for zombie in IdentifiedIgniters do
                        if not zombie or not zombie.Parent then
                            IdentifiedIgniters[zombie] = nil
                        end
                    end
                end

                task.wait(2.0)
            end
        end)
        local lastUpdate = 0
        local UPDATE_INTERVAL = 0.1
        renderConn = RunService.Heartbeat:Connect(function()
            local now = time()
            if now - lastUpdate < UPDATE_INTERVAL then return end
            lastUpdate = now

            local cam = workspace.CurrentCamera
            if cam then
                cachedCameraPos = cam.CFrame.Position
                lastCameraCacheTime = now
            end

            UpdateAllBillboards()
        end)
    end
end

local function StopShared()
    activeCount = activeCount - 1
    if activeCount == 0 then
        if scanLoop then task.cancel(scanLoop); scanLoop = nil end
        if renderConn then renderConn:Disconnect(); renderConn = nil end
        for k in ESPPendingRemoval do ESPPendingRemoval[k] = nil end
        for k in IdentifiedIgniters do IdentifiedIgniters[k] = nil end
        for espType in ESPData do
            for zombie in ESPData[espType] do
                RemoveVisual(espType, zombie)
            end
            ESPData[espType] = setmetatable({}, { __mode = "k" })
        end
    end
end

local function TogglePerformanceMode(state)
    PerformanceMode = state
    for espType in ESPConfigs do
        for zombie, data in ESPData[espType] do
            if data.highlight then
                data.highlight.Enabled = not state
            end
            if data.dot then
                data.dot.Enabled = state
            end
        end
    end
end

local LastChargeState = false
local NotifyCuirassierCharge = false
local CuirassierStateLoop

local function IsCharging(state)
    state = tostring(state or ""):lower()
    return (state == "begincharge" or state == "charge")
end

local function UpdateCuirassierState()
    local zFolder = workspace:FindFirstChild("Zombies")
    if not zFolder then return end
    local slim = zFolder:FindFirstChild("Slim")
    if not slim then return end
    local stateVal = slim:FindFirstChild("State")
    if not stateVal or not stateVal:IsA("StringValue") then return end

    local charging = IsCharging(stateVal.Value)
    for _, data in pairs(ESPData.Cuirassier) do
        if data.label and (data.frame or true) then
            if charging then
                data.label.Text = "Charging"
                data.label.TextColor3 = Color3.fromRGB(255, 80, 80)
                if data.frame then data.frame.BorderColor3 = Color3.fromRGB(255, 80, 80) end
            else
                data.label.Text = "Cuirassier"
                data.label.TextColor3 = ESPConfigs.Cuirassier.color
                if data.frame then data.frame.BorderColor3 = ESPConfigs.Cuirassier.color end
            end
        end
    end
    if charging and NotifyCuirassierCharge and not LastChargeState then
        pcall(function()
            if Library and typeof(Library.Notify) == "function" then
                Library:Notify({ Title = "Cuirassier Charge", Description = "A Cuirassier is Charging!", Icon = "bell", Time = 3 })
            end
        end)
    end
    LastChargeState = charging
end

local function StartCuirassierSpecific()
    LastChargeState = false
    UpdateCuirassierState()
    CuirassierStateLoop = task.spawn(function()
        while EnabledESPs.Cuirassier do
            UpdateCuirassierState()
            task.wait(0.5)
        end
    end)
end

local function StopCuirassierSpecific()
    if CuirassierStateLoop then task.cancel(CuirassierStateLoop); CuirassierStateLoop = nil end
    LastChargeState = false
end

local function ApplyColorToExisting(espType, color)
    local dataTable = ESPData[espType]
    if not dataTable then return end
    for zombie, data in dataTable do
        pcall(function()
            if data.highlight then data.highlight.FillColor = color end
            if data.frame then data.frame.BorderColor3 = color end
            if data.label then data.label.TextColor3 = color end
            if data.dot then
                for _, child in data.dot:GetDescendants() do
                    if child:IsA("Frame") then child.BackgroundColor3 = color end
                end
            end
        end)
    end
end

local EspList = { "Bomber", "Cuirassier", "Runner", "Zapper", "Igniter", "Shambler" }
SelectedESPs = _G.SelectedESPs or {}
previousSelectedESPs = _G.previousSelectedESPs or {}
local espToggle -- forward ref

local function RemoveAllVisualsForType(typeName)
    local t = ESPData[typeName]
    if not t then return end
    for zombieModel, data in t do
        if data then
            if data.highlight then pcall(function() data.highlight:Destroy() end) end
            if data.billboard then pcall(function() data.billboard:Destroy() end) end
            if data.dot then pcall(function() data.dot:Destroy() end) end
            data.highlight = nil
            data.billboard = nil
            data.dot = nil
            data.frame = nil
            data.label = nil
            data.distLabel = nil
        end
        if zombieModel then
            IdentifiedIgniters[zombieModel] = nil
            ESPPendingRemoval[zombieModel] = nil
        end
    end
    ESPData[typeName] = setmetatable({}, { __mode = "k" })
end

local function AnyESPEnabled()
    for k, v in EnabledESPs do
        if v then return true end
    end
    return false
end

-- UI: Select ESP Types dropdown (multi-select)
local espDropdown = ESPSection:AddDropdown('EspTypes', {
    Text = "Select ESP Types",
    Multi = true,
    Values = EspList,
    Default = {},
    Callback = function(newSelection)
        local newSelection = newSelection or {}

        local newSet = {}
        for key, _ in newSelection do newSet[tostring(key)] = true end

        for _, removedKey in previousSelectedESPs do
            if not newSet[tostring(removedKey)] then
                RemoveAllVisualsForType(removedKey)
                EnabledESPs[removedKey] = false
                if removedKey == "Cuirassier" then
                    pcall(function() StopCuirassierSpecific() end)
                end
                if not AnyESPEnabled() then pcall(function() StopShared() end) end

                if ESPTab_InitComplete then
                    pcall(function()
                        Library:Notify({
                            Title = (removedKey .. " ESP"),
                            Description = (removedKey .. " ESP disabled (deselected)"),
                            Icon = "eye-off",
                            Time = 1
                        })
                    end)
                end
            end
        end

        SelectedESPs = {}
        for key, _ in newSelection do table.insert(SelectedESPs, key) end

        previousSelectedESPs = {}
        for _, v in SelectedESPs do table.insert(previousSelectedESPs, v) end

        if espToggle then
            local anySelected = (#SelectedESPs > 0)
            if not anySelected then
                pcall(function() espToggle:SetValue(false) end)
            else
                local allEnabled = true
                for _, key in SelectedESPs do
                    if not EnabledESPs[key] then
                        allEnabled = false
                        break
                    end
                end
                pcall(function() espToggle:SetValue(allEnabled) end)
            end
        end

        if ESPTab_InitComplete then
            pcall(function()
                Library:Notify({
                    Title = "ESP Selection",
                    Description = (#SelectedESPs > 0) and ("Selected: " .. table.concat(SelectedESPs, ", ")) or "No selection",
                    Icon = "eye",
                    Time = 1
                })
            end)
        end
    end
})

-- UI: Enable selected ESP toggle
espToggle = ESPSection:AddToggle('EspSelect', {
    Text = "Enable Selected ESP",
    Default = false,
    Tooltip = "Enable Esp From The Selected Type.",
    Callback = function(state)
        if not SelectedESPs or #SelectedESPs == 0 then
