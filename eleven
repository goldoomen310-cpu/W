local function safeRequire(moduleInstance)
    if not moduleInstance then
        return "absent", "module not present"
    end
    local ok, res = pcall(function() return require(moduleInstance) end)
    if not ok then
        return "failed", res
    end
    return "ok", res
end

local function resolveZombieHitModel(hitInstance)
    local node = hitInstance
    while node and node ~= Workspace do
        if node:IsA("Model") then
            local tagged = false
            pcall(function()
                tagged = CollectionService:HasTag(node, "ZombieLike") or node:HasTag("ZombieLike")
            end)

            if node.Name == "m_Zombie" or tagged or (node:FindFirstChild("Orig") and node:FindFirstChild("Head")) then
                return node
            end
        end
        node = node.Parent
    end
    return nil
end

local function resolveZombieHeadPart(zombieModel)
    if not zombieModel then return nil end
    local head = zombieModel:FindFirstChild("Head")
    if not head then return nil end
    if head:IsA("BasePart") then return head end
    return head:FindFirstChildWhichIsA("BasePart", true)
