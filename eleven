    -- ===== Dracula attack loop (with loop-id cancellation) =====
    local currentDraculaLoopId = 0

    local draculaAttackLoopRunning = false
    local draculaAttackLoopThread = nil
    local function stopDraculaAttackLoop()
        draculaAttackLoopRunning = false
        if draculaAttackLoopThread then
            pcall(function() task.cancel(draculaAttackLoopThread) end)
            draculaAttackLoopThread = nil
        end
    end
    _G.KatchiStopDraculaAttackLoop = stopDraculaAttackLoop

    local function startDraculaAttackLoop()
        if draculaAttackLoopThread then return end
        draculaAttackLoopRunning = true
        draculaAttackLoopThread = task.spawn(function()
            while draculaAttackLoopRunning and (HitDraculaEnabled or DraculaEspEnabled) do
                task.wait(DraculaLoopInterval)
                if not HitDraculaEnabled then
                    -- keep ESP in sync (only if ESP enabled)
                    if DraculaEspEnabled then pcall(updateDraculaESP) end
                    continue
                end

                -- new tick: increment loop id to cancel previous spawned tasks
                currentDraculaLoopId = currentDraculaLoopId + 1
                local loopId = currentDraculaLoopId

                local drac = getDracula()
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not (drac and hrp) then
                    pcall(updateDraculaESP)
                    continue
                end

                -- distance check (safe)
                local ok, pivot = pcall(function() return drac:GetPivot().Position end)
                if not ok or not pivot then
                    pcall(updateDraculaESP)
                    continue
                end
                local dist = (pivot - hrp.Position).Magnitude
                if dist > DraculaRange then
                    pcall(updateDraculaESP)
                    continue
                end

                -- ensure remotes are fresh
                if time() - lastDraculaRemoteScan > 1 then ScanDraculaRemotes() end

                -- update ESP
                pcall(updateDraculaESP)

                -- Execute Hit Sequence in a single throttled batch block to prevent overlapping threads
                local spam = math.clamp(math.floor(DraculaSpamCount or 1), 1, 25)

                for remote in draculaRemotes do
                    if remote then
                        -- 1) Swing spam
                        for i = 1, spam do
                            if not HitDraculaEnabled or loopId ~= currentDraculaLoopId then break end
                            fireSwingRemote(remote)
                        end

                        -- 2) Hit packets burst (3 times max as originally required, but with safer spacing)
                        for i = 1, 3 do
                            if not HitDraculaEnabled or loopId ~= currentDraculaLoopId then break end
                            fireHitAtDracula(remote, drac)
                            task.wait(DraculaHitSpacing or 0.03) -- Ensure slight delay to not crash server
                        end
                    end
                end
            end
            draculaAttackLoopThread = nil
        end)
    end

    local function refreshDraculaWorkers()
        if HitDraculaEnabled or DraculaEspEnabled then
            startDraculaScanLoop()
            startDraculaAttackLoop()
        else
            stopDraculaScanLoop()
            stopDraculaAttackLoop()
        end
    end

